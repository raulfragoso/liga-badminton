# Configurações de Variáveis de Ambiente - Liga de Badminton

# Configuração do Administrador Master da Liga
# Configure na Vercel para alterar a senha do Administrador com total segurança sem mexer no código
VITE_ADMIN_PHONE=admin
VITE_ADMIN_PASSWORD=sua-senha-admin-aqui

# Integração com Supabase (Banco de Dados em Nuvem Compartilhado)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui
